# Copy this file to .env and fill in your actual values from
# Supabase → Project Settings → API. The .env file itself is
# gitignored and never leaves your machine.
#
# VITE_SUPABASE_ANON_KEY is the "anon public" key — safe to use in
# client code, NOT the "service_role" key (never put that one here).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
